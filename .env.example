# Sao chép thành .env rồi chỉnh sửa. docker compose tự đọc file .env.

# ---- Bí mật dùng chung (BẮT BUỘC đổi khi triển khai thật) ----
# Khoá ký JWT HS256 dùng chung cho mọi service (>= 32 byte). Thiếu => service dùng khoá dev và log WARNING.
JWT_SECRET=change-me-please-use-a-long-random-string-at-least-32-bytes
# Header X-Internal-Token cho các lời gọi /internal/** giữa các service. Thiếu => dùng khoá dev và log WARNING.
INTERNAL_API_KEY=change-me-internal-service-key
# Môi trường thật: bật kiểm tra NFR-9 — service từ chối khởi động nếu 2 biến trên còn giá trị dev mặc định.
# SPRING_PROFILES_ACTIVE=prod   (auth-service, learning-service)
# APP_ENV=prod                  (ai-service)

# ---- auth-service ----
# Tài khoản ADMIN được tạo sẵn lúc khởi động lần đầu — nên đổi mật khẩu mặc định.
ADMIN_EMAIL=admin@mmp.local
ADMIN_PASSWORD=Admin@123
# US-38 — gửi email: log (mặc định, đọc qua log / GET /internal/dev/emails) | smtp (cần `docker compose --profile mail up`,
# xem email ở http://localhost:8025).
EMAIL_MODE=log
# URL frontend dùng để tạo link trong email/link giới thiệu (auth-service, payment-service).
FRONTEND_URL=http://localhost:3000

# ---- mentoring-service ----
# Nhắc lịch cố định 24 giờ và 1 giờ trước giờ bắt đầu (US-34, PRD-SES-14) — không còn cấu hình REMINDER_BEFORE.

# ---- ai-service ----
# Để trống DEEPSEEK_API_KEY => AI Interview & CV enrichment dùng engine rule-based (chạy offline).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Số lượt hỏi tối đa của một buổi AI Interview / một cuộc trò chuyện bổ sung hồ sơ.
INTERVIEW_MAX_TURNS=5
ENRICHMENT_MAX_TURNS=4

# ---- matching-service ----
# Chu kỳ (giây) job đồng bộ chỉ mục embedding với profile_db.
INDEX_SYNC_INTERVAL=60
# Model sentence-transformers; đổi model phải giữ đúng 384 chiều (VECTOR(384) trong matching_db).
EMBEDDING_MODEL=all-MiniLM-L6-v2
# true => load model lúc khởi động (request đầu không bị chậm); test đặt false.
PRELOAD_MODEL=true
# Bật/tắt IndexSyncJob (lưới an toàn khi thông báo reindex từ profile-service bị mất).
INDEX_SYNC_ENABLED=true
# Số hồ sơ tối đa mỗi vai trò được embed lại trong một vòng đồng bộ.
INDEX_SYNC_BATCH=200
# Cổng thanh toán (US-56): sandbox = giả lập trong tiến trình (offline/CI) | momo = MoMo test | vnpay = VNPay sandbox.
PAYMENT_GATEWAY=sandbox
# MoMo test: khoá test dùng chung, công khai trong repo mẫu chính thức github.com/momo-wallet/payment (không phải khoá riêng).
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
# URL công khai để MoMo gọi IPN (vd. https://pay-dev.stuffsy.site/api/payment/momo/ipn); trống khi chạy local.
MOMO_IPN_URL=
# VNPay sandbox: lấy TMN_CODE / HASH_SECRET từ email đăng ký merchant TEST của VNPay — không commit giá trị thật.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
