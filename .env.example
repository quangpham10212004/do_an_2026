# Sao chép thành .env rồi chỉnh sửa. docker compose tự đọc file .env.
JWT_SECRET=change-me-please-use-a-long-random-string-at-least-32-bytes
INTERNAL_API_KEY=change-me-internal-service-key
# ai-service: để trống DEEPSEEK_API_KEY => AI Interview & CV enrichment dùng engine rule-based (chạy offline).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Đặt lịch nâng cao (mentoring-service) — chính sách kinh doanh, có thể chỉnh; xem docs/booking-flows.md ---
# Buổi làm quen: thời lượng (phút) và số yêu cầu đang làm quen tối đa của mỗi mentor
# INTRO_DURATION_MINUTES=15
# INTRO_MAX_OPEN_PER_MENTOR=5
# Đổi lịch: mentee đổi trước giờ hẹn ít nhất ngần này thì tự áp dụng; số lần tự đổi tối đa mỗi phiên
# RESCHEDULE_FREE_WINDOW=PT24H
# RESCHEDULE_MAX_PER_SESSION=2
# Gói buổi: "số buổi:phần trăm giảm" cách nhau bằng dấu phẩy; thời hạn dùng; phí giữ lại khi hoàn tiền buổi chưa dùng
# PACKAGE_TIERS=4:10,8:15
# PACKAGE_VALIDITY=P90D
# PACKAGE_REFUND_FEE_PERCENT=0
